# ============ fashionOS API ortam değişkenleri ============
# Yerelde: bu dosyayı apps/api/.env olarak kopyalayın. Railway'de: Variables sekmesine girin.

NODE_ENV=development
PORT=4000
# Web uygulamasının adresi (e-posta bağlantıları ve ödeme dönüşleri için)
APP_URL=http://localhost:5173

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://KULLANICI:SIFRE@cluster0.xxxxx.mongodb.net/fashionos?retryWrites=true&w=majority

# --- Oturum ---
# En az 32 karakter rastgele bir değer: `openssl rand -base64 48`
SESSION_SECRET=
SESSION_DAYS=30

# --- Fotoğraf depolama: AWS S3 ---
# Yerelde S3 olmadan denemek için: STORAGE_DRIVER=local
STORAGE_DRIVER=s3
S3_BUCKET=fashionos-uploads
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# İmzalı görsel bağlantılarının geçerlilik süresi (saniye)
S3_SIGNED_URL_TTL=3600
MAX_UPLOAD_MB=15

# --- Yapay zekâ: açık kaynak Qwen (OpenAI uyumlu herhangi bir sağlayıcı) ---
# OpenRouter (varsayılan):  AI_BASE_URL=https://openrouter.ai/api/v1
# Alibaba DashScope (intl): AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Ollama (kendi sunucun, tamamen ücretsiz): AI_BASE_URL=http://SUNUCU:11434/v1  (AI_API_KEY boş kalabilir)
AI_ENABLED=true
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Görsel destekli model (fotoğraftan etiketleme) ve stilist modeli
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_TEXT_MODEL=qwen/qwen3.8-27b
# Sağlayıcı JSON modunu desteklemiyorsa false yapın (yine de çalışır)
AI_JSON_MODE=true
AI_TIMEOUT_MS=60000

# --- E-posta (doğrulama, şifre sıfırlama) — boşsa e-postalar log'a yazılır ---
# ör. smtp://apikey:SIFRE@smtp.sendgrid.net:587  veya  smtps://kullanici:sifre@smtp.yandex.com:465
SMTP_URL=
MAIL_FROM=fashionOS <no-reply@alanadiniz.com>

# --- Ödeme (Stripe) — boşsa Pro'ya geçiş butonu pasif ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Sadece web farklı bir alan adından doğrudan API'ye istek atacaksa (Netlify proxy kullanılıyorsa gerekmez)
CORS_ORIGINS=
